ngx_addon_name=ngx_http_push_stream_module

# One translation unit: ngx_http_push_stream_module.c #includes the other
# .c files, so only it is compiled.  They still belong in the dependency
# list, or make will not rebuild after one of them changes.
ngx_module_type=HTTP
ngx_module_name=$ngx_addon_name
ngx_module_incs="$ngx_addon_dir/src $ngx_addon_dir/include"
ngx_module_srcs="$ngx_addon_dir/src/$ngx_addon_name.c"
ngx_module_deps=" \
	$ngx_addon_dir/include/ngx_http_push_stream_module.h \
	$ngx_addon_dir/include/ngx_http_push_stream_module_ipc.h \
	$ngx_addon_dir/include/ngx_http_push_stream_module_publisher.h \
	$ngx_addon_dir/include/ngx_http_push_stream_module_setup.h \
	$ngx_addon_dir/include/ngx_http_push_stream_module_subscriber.h \
	$ngx_addon_dir/include/ngx_http_push_stream_module_utils.h \
	$ngx_addon_dir/include/ngx_http_push_stream_module_version.h \
	$ngx_addon_dir/include/ngx_http_push_stream_module_websocket.h \
	$ngx_addon_dir/include/ngx_http_push_stream_rbtree_util.h \
	$ngx_addon_dir/src/ngx_http_push_stream_module_setup.c \
	$ngx_addon_dir/src/ngx_http_push_stream_module_ipc.c \
	$ngx_addon_dir/src/ngx_http_push_stream_module_publisher.c \
	$ngx_addon_dir/src/ngx_http_push_stream_module_subscriber.c \
	$ngx_addon_dir/src/ngx_http_push_stream_module_utils.c \
	$ngx_addon_dir/src/ngx_http_push_stream_module_websocket.c \
	$ngx_addon_dir/src/ngx_http_push_stream_rbtree_util.c \
	"
ngx_module_libs=

. auto/module

have=NGX_HTTP_HEADERS . auto/have

# WebSocket subscribers need a SHA-1, which nginx carries in its core.
have=NGX_HAVE_SHA1 . auto/have
